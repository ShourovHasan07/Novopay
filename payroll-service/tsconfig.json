{
  "compilerOptions": {
    "module": "commonjs",                    // Node.js এর জন্য module system
    "target": "ES2020",                      // Output JS version
    "strict": true,                          // সব strict TypeScript rules চালু করবে
    "experimentalDecorators": true,          // Decorators enable করতে হবে
    "emitDecoratorMetadata": true,           // Decorators metadata generate করবে
    "strictPropertyInitialization": true,    // Property init rules enforce করবে
    "esModuleInterop": true,                 // Import compatibility
    "skipLibCheck": true,                     // node_modules ignore করবে
    "forceConsistentCasingInFileNames": true // File names case sensitive check
  },
  "include": ["src/**/*"],                    // যেসব ফাইল compile হবে
  "exclude": ["node_modules", "dist"]         // exclude folders
}