{
  "compilerOptions": {
    "module": "commonjs",                   
    "target": "ES2020",                      
    "strict": true,                         
    "experimentalDecorators": true,          
    "emitDecoratorMetadata": true,           
    "strictPropertyInitialization": true,    
    "esModuleInterop": true,                 
    "skipLibCheck": true,                    
    "forceConsistentCasingInFileNames": true 
  },
  "include": ["src/**/*"],                    
  "exclude": ["node_modules", "dist"]       
}